NODE_ENV=development
TZ=UTC
PORT=3001

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=uptime
MYSQL_PASSWORD=uptime
MYSQL_DATABASE=uptime
MYSQL_CONNECTION_LIMIT=10
# Pool hygiene. Idle connections are retired after MYSQL_IDLE_TIMEOUT_MS, which
# must stay comfortably below the MySQL server's wait_timeout, otherwise the
# server closes them first and the pool hands out dead sockets.
# MYSQL_MAX_IDLE must be lower than MYSQL_CONNECTION_LIMIT or mysql2 never runs
# its idle-eviction timer (defaults to half the connection limit).
MYSQL_IDLE_TIMEOUT_MS=60000
MYSQL_MAX_IDLE=5
MYSQL_ENABLE_KEEPALIVE=true
MYSQL_KEEPALIVE_INITIAL_DELAY_MS=10000
# Periodic pool ping so dead connections are discarded by the keepalive loop
# instead of by a failing query. 0 disables.
MYSQL_PING_INTERVAL_MS=30000

MONITOR_POLL_MS=1000
REQUEST_TIMEOUT_MS=10000
NATS_LAG_THRESHOLDS={"ads_apis_consumer_google":1024,"ads_apis_consumer_facebook":1024,"default":128}
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

VITE_API_BASE_URL=

SESSION_SECRET=replace-with-random-secret
SESSION_MAX_AGE_MS=86400000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_HOSTED_DOMAIN=
CONTROL_PLANE_PATH=/monitors
LOGIN_PATH=/login
TRUST_PROXY=false
CONTROL_PLANE_ADMIN_EMAILS=
ALLOW_NEW_ACCOUNTS=true

NOTIFICATIONS_ENABLED=true
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
NOTIFICATION_TARGETS_JSON=[]
NATS_CLIENT='{ "username": "master", "password": "password", "address": "192.168.1.1:4242" }'
# Bearer token required by POST /api/crons/notify (open with a startup warning when empty)
CRON_NOTIFY_TOKEN=
# Dead man's switch grace: extra slack, on top of the next occurrence plus the
# cron's start/ping windows, before a cron with no successful run is marked
# unhealthy and alerted on
CRON_HEALTH_GRACE_MS=300000

# Bearer token required by POST /api/metrics/ingest (503 until set, 401 on mismatch)
METRICS_INGEST_TOKEN=
# TTL (in days) applied to the ClickHouse raw sample tables
METRIC_RETENTION_DAYS=90
METRIC_DIMENSION_PRUNE_DAYS=7
METRIC_ALERT_POLL_MS=60000

# ClickHouse stores the raw metric samples (HTTP interface, usually port 8123).
# The database and tables are created on startup if they do not exist.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=uptime_metrics